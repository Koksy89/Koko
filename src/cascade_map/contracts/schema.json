    "Contradiction": {
      "additionalProperties": false,
      "description": "An observation that disagrees with a static claim. Card 12 needs these and `Unresolved` cannot carry them: it has no `Provenance`, so it cannot hold the run and event IDs constraint 2 requires of every runtime fact. A contradiction recorded without its evidence is not checkable, which defeats the point of recording it. These are among the most valuable records the tool produces. An edge the static graph predicted that never fires, a call it did not predict, an order that differs -- each marks a place the static analysis was wrong, and the owner wants to know exactly where. The static graph is never edited to match; the disagreement is the finding.",
      "properties": {
        "claim": {
          "type": "string"
        },
        "element_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "static_evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "claim",
        "element_id",
        "id",
        "observation",
        "provenance"
      ],
      "type": "object"
    },
