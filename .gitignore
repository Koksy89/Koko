# Card 1's incremental cache. Keyed on content hash, regenerated on demand,
# and never a source of truth — committing it would let a stale record survive
# a change, which is the one thing the content-hash key exists to prevent.
.cascade_map/

# Read-only copies of the analysis target — never committed.
target_engine/
target_versions/
.venv-target/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ...except the deliverable. `dist/cascade_map.py` is the whole tool in one
# file, generated by `tools/amalgamate.py` and checked by
# `tests/test_amalgamate.py` against the package's output. It is committed
# because it is what an owner downloads and runs; it lives under `dist/`
# rather than at the root so it cannot shadow the `cascade_map` package for
# anything run from here.
!dist/cascade_map.py

# Packaged deploy kits. Regenerable from the tracked kit/<sport>/ tree with
# `tar -czf kit_<sport>.tar.gz -C kit <sport>`; committing the archive would
# duplicate tracked files as an opaque binary.
AmunEV/kit_*.tar.gz
